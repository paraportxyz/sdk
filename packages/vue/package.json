{
  "name": "@paraport/vue",
  "type": "module",
  "version": "0.2.1",
  "description": "Vue components for ParaPort SDK",
  "author": "Paraport",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paraportxyz/sdk"
  },
  "keywords": [
    "paraport",
    "polkadot",
    "sdk",
    "vue"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/index.css"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "style": "./dist/index.css",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vue-tsc && vite build",
    "build:types": "vue-tsc -p tsconfig.types.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "peerDependencies": {
    "polkadot-api": "2.1.x"
  },
  "dependencies": {
    "@paraport/core": "workspace:*",
    "@tanstack/vue-table": "^8.21.3",
    "@vue/runtime-dom": "^3.5.34",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dedot": "^1.3.0",
    "lucide-vue-next": "^1.0.0",
    "mitt": "^3.0.1",
    "reka-ui": "^2.9.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@biomejs/biome": "^2.4.15",
    "@types/sass": "^1.45.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "jsdom": "^29.1.1",
    "polkadot-api": "2.1.x",
    "postcss": "^8.5.14",
    "sass": "^1.99.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^3.2.9"
  }
}
