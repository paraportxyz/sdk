{
	"name": "@paraport/sdk",
	"version": "0.1.14",
	"description": "ParaPort Embedded UI",
	"keywords": ["paraport", "polkadot", "sdk"],
	"author": "Paraport",
	"license": "MIT",
	"type": "module",
	"files": ["dist", "README.md"],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/paraportxyz/sdk"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"style": "./dist/index.css",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./style": "./dist/index.css"
	},
	"scripts": {
		"dev": "vite build --watch --mode development",
		"build": "vite build",
		"lint": "biome check --write .",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"polkadot-api": "2.1.x"
	},
	"dependencies": {
		"@paraport/vue": "workspace:*",
		"@paraport/core": "workspace:*",
		"vue": "^3.5.34"
	},
	"devDependencies": {
		"polkadot-api": "2.1.x",
		"@biomejs/biome": "^2.4.15",
		"@vitest/coverage-v8": "^4.1.6",
		"jsdom": "^29.1.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.13",
		"vite-plugin-dts": "^5.0.0",
		"vitest": "^4.1.6"
	}
}
